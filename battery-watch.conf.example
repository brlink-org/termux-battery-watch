# Copie para ~/.battery-watch.conf e edite SOMENTE no aparelho.
# Nunca publique este arquivo preenchido.
EVO_URL="https://sua-evolution.exemplo.com"
EVO_TOKEN="INSIRA_SUA_CHAVE_API"
EVO_INSTANCE="nome_da_instancia"
DESTINO="5571999999999"  # codigo do pais + DDD + telefone, sem +

INTERVALO=60
LIMIAR_BAIXO=30
LIMIAR_RESET=33
# Opcionais: padrão crítico de 15% (0 desativa); rearme acima de 18%.
# LIMIAR_CRITICO=15
# LIMIAR_CRITICO_RESET=18
LIMIAR_CHEIO=100
LIMIAR_CHEIO_RESET=98
# DRY=1   # somente testes, sem envio real

# Destino de grupo (alternativa ao número acima):
# DESTINO='5511999999999-1571774628@g.us'
# DESTINO='120363000000000000@g.us'

# Mensagens opcionais: use aspas simples e o marcador literal {percentual}.
# MSG_BAIXA_DESCONECTADO='🔋 Bateria baixa: {percentual}% (descarregando). Coloque para carregar.'
# MSG_BAIXA_CONECTADO='🔋 Bateria baixa: {percentual}% apesar da fonte conectada. Verifique o carregamento.'
# MSG_BAIXA_DESCONHECIDO='🔋 Bateria baixa: {percentual}%. Nao foi possivel confirmar a alimentacao.'
# MSG_CARREGADOR_CONECTADO='🔌 Carregador conectado — bateria em {percentual}%.'
# MSG_CARGA_COMPLETA='✅ Bateria em {percentual}% — carga completa, pode desconectar.'
# MSG_BATERIA_CRITICA='🚨 Bateria crítica: {percentual}%. Verifique a alimentação imediatamente.'
# MSG_CARREGADOR_INFERIDO='🔌 Carregamento detectado — bateria em {percentual}% (fonte inferida).'
